{
  "name": "governed-ai-ide",
  "displayName": "Governed AI IDE",
  "description": "Intent-Code Traceability layer for AI coding agents (Roo Code / Cline fork)",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "governedAI.showStatus",
        "title": "Governed AI: Show Session Status"
      },
      {
        "command": "governedAI.newSession",
        "title": "Governed AI: New Agent Session"
      },
      {
        "command": "governedAI.listIntents",
        "title": "Governed AI: List Active Intents"
      },
      {
        "command": "governedAI.addIntent",
        "title": "Governed AI: Add New Intent"
      },
      {
        "command": "governedAI.openTraceLog",
        "title": "Governed AI: Open Trace Log"
      }
    ],
    "configuration": {
      "title": "Governed AI IDE",
      "properties": {
        "governedAI.enableHITL": {
          "type": "boolean",
          "default": true,
          "description": "Enable Human-in-the-Loop approval dialogs for destructive/elevated actions."
        },
        "governedAI.enableScopeEnforcement": {
          "type": "boolean",
          "default": true,
          "description": "Block agent writes outside the declared intent's owned_scope."
        },
        "governedAI.enableConcurrencyGuard": {
          "type": "boolean",
          "default": true,
          "description": "Block writes to files modified by another parallel agent."
        },
        "governedAI.enableTracing": {
          "type": "boolean",
          "default": true,
          "description": "Write all agent actions to agent_trace.jsonl."
        },
        "governedAI.agentLabel": {
          "type": "string",
          "default": "Builder",
          "enum": ["Architect", "Builder", "Tester"],
          "description": "Label for this agent session (used in trace ledger)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest --coverage"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"]
  }
}